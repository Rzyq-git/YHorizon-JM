{
    "version": 3,
    "configurePresets": [
        {
            "name": "gd32f303",
            "displayName": "GD32F303 voltage-mode servo",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "gd32f303-debug",
            "displayName": "GD32F303 voltage-mode servo (Debug)",
            "inherits": "gd32f303",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "gd32f303",
            "configurePreset": "gd32f303"
        },
        {
            "name": "gd32f303-debug",
            "configurePreset": "gd32f303-debug"
        }
    ]
}
